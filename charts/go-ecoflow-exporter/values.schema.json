{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "go-ecoflow-exporter values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Keep at 1; extra replicas duplicate every series and double the EcoFlow API load."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Recreate", "RollingUpdate"] }
      }
    },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "containerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mqtt", "rest"],
          "description": "Any other value makes the exporter log 'Unknown exporter type' and exit."
        },
        "metricPrefix": { "type": "string", "minLength": 1 },
        "devices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Device serial numbers. Was a comma-separated string before chart 0.9.0."
        },
        "devicesPrettyNames": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "serial number -> display name. Was a JSON string before chart 0.9.0."
        },
        "mqtt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deviceOfflineThresholdSeconds": { "type": "integer", "minimum": 1 },
            "pingIntervalSeconds": { "type": "integer", "minimum": 1 },
            "stateRefreshIntervalSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "rest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scrapingIntervalSeconds": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "required": ["type"]
    },
    "existingSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessKey": { "type": "string", "minLength": 1 },
            "secretKey": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "devices": { "type": "string", "minLength": 1 },
            "devicesPrettyNames": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "honorLabels": { "type": "boolean" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    },
    "prometheusScrapeAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "mqttStallRecovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "afterMinutes": {
          "type": "integer",
          "minimum": 2,
          "description": "Restart the pod after this many minutes with no device online. Becomes the liveness failureThreshold at a 60s period."
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "extraEnv": { "type": "array" },
    "envFrom": { "type": "array" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    }
  }
}
