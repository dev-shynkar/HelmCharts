{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "transmission values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "State lives on a ReadWriteOnce volume and the peer hostPort is exclusive; a second pod cannot start."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Recreate", "RollingUpdate"] }
      }
    },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "nodePort": { "type": ["string", "integer"] }
      }
    },
    "peerPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "hostPort": {
          "type": "boolean",
          "description": "Bind the peer port on the node. Required for incoming peer connections."
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": { "type": "array" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host", "paths"]
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "extraEnv": { "type": "array" },
    "envFrom": { "type": "array" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": {
              "type": "string",
              "description": "A PVC this chart does not manage. Never point it at a PVC an earlier chart version created — Helm deletes it on upgrade. Use claimName instead."
            },
            "claimName": {
              "type": "string",
              "description": "Name of the PVC this chart creates. Set it to keep a name from an older release under management."
            },
            "storageClassName": { "type": "string" },
            "accessModes": { "$ref": "#/definitions/accessModes" },
            "size": { "$ref": "#/definitions/quantity" },
            "annotations": { "type": "object" },
            "retain": { "type": "boolean" }
          },
          "required": ["enabled"]
        },
        "downloads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "type": {
              "type": "string",
              "enum": ["hostPath", "pvc"],
              "description": "hostPath additionally requires nodeSelector or affinity."
            },
            "hostPath": { "type": "string" },
            "existingClaim": {
              "type": "string",
              "description": "A PVC this chart does not manage. Never point it at a PVC an earlier chart version created — Helm deletes it on upgrade. Use claimName instead."
            },
            "claimName": {
              "type": "string",
              "description": "Name of the PVC this chart creates. Set it to keep a name from an older release under management."
            },
            "storageClassName": { "type": "string" },
            "accessModes": { "$ref": "#/definitions/accessModes" },
            "size": { "$ref": "#/definitions/quantity" },
            "annotations": { "type": "object" },
            "retain": { "type": "boolean" }
          },
          "required": ["enabled"]
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "type": "string", "enum": ["hostPath", "pvc"] },
            "hostPath": { "type": "string" },
            "existingClaim": { "type": "string" }
          },
          "required": ["enabled"]
        }
      }
    },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "priorityClassName": { "type": "string" }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    },
    "accessModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
      }
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|k|Ei|Pi|Ti|Gi|Mi|Ki)?$"
    }
  }
}
