{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "duplicati values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Several instances writing the same SQLite server database in /data will corrupt it."
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Recreate", "RollingUpdate"],
          "description": "RollingUpdate is rejected at render time while persistence.config is a chart-managed ReadWriteOnce claim: two pods would write the same server database."
        }
      }
    },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Labels added to every rendered object. Never merged into the immutable selector labels."
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Annotations added to every rendered object. On a PVC, persistence.*.retain still wins over helm.sh/resource-policy."
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "nodePort": { "type": ["string", "integer"] }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": { "type": "array" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host", "paths"]
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "password": { "type": "string" },
            "encryptionKey": { "type": "string" }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "description": "UID/GID make the entrypoint drop root. DUPLICATI__WEBSERVICE_ALLOWED_HOSTNAMES is computed unless set here."
    },
    "extraEnv": { "type": "array" },
    "envFrom": { "type": "array" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": {
              "type": "string",
              "description": "A PVC this chart does not manage. Never point it at a PVC an earlier chart version created — Helm deletes it on upgrade. Use claimName instead."
            },
            "claimName": {
              "type": "string",
              "description": "Name of the PVC this chart creates. Set to the 0.18.x name (pvc-duplicati-config) to keep an existing volume under management."
            },
            "storageClassName": { "type": "string" },
            "accessModes": { "$ref": "#/definitions/accessModes" },
            "size": { "$ref": "#/definitions/quantity" },
            "annotations": { "type": "object" },
            "retain": { "type": "boolean" }
          },
          "required": ["enabled"]
        },
        "source": { "$ref": "#/definitions/dataVolume" },
        "backups": { "$ref": "#/definitions/dataVolume" }
      }
    },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["string", "integer"] },
        "maxUnavailable": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": {
          "type": "array",
          "description": "An empty list means every source in the cluster: a rule with ports and no `from` matches everything."
        },
        "egress": { "type": "array" },
        "allowDNS": {
          "type": "boolean",
          "description": "Append a kube-system :53 UDP/TCP rule to egress. Ignored while egress is empty, since egress is then unrestricted anyway."
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "runAsUser": {
          "type": ["string", "integer"],
          "description": "Empty falls back to env.UID, then to 1000."
        }
      }
    },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    },
    "accessModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
      }
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|k|Ei|Pi|Ti|Gi|Mi|Ki)?$"
    },
    "dataVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": ["pvc", "hostPath"],
          "description": "hostPath additionally requires nodeSelector or affinity."
        },
        "existingClaim": {
          "type": "string",
          "description": "A PVC this chart does not manage. Never point it at a PVC an earlier chart version created — Helm deletes it on upgrade. Use claimName instead."
        },
        "claimName": {
          "type": "string",
          "description": "Name of the PVC this chart creates. Set to the 0.18.x name (pvc-duplicati-source / pvc-duplicati-backups) to keep an existing volume under management."
        },
        "hostPath": { "type": "string" },
        "hostPathType": {
          "type": "string",
          "enum": ["Directory", "DirectoryOrCreate"],
          "description": "Directory refuses to start the pod when the path is missing; DirectoryOrCreate silently creates an empty one. source defaults to Directory, backups to DirectoryOrCreate."
        },
        "readOnly": { "type": "boolean" },
        "storageClassName": { "type": "string" },
        "accessModes": { "$ref": "#/definitions/accessModes" },
        "size": { "$ref": "#/definitions/quantity" },
        "annotations": { "type": "object" },
        "retain": { "type": "boolean" }
      },
      "required": ["enabled"]
    }
  }
}
